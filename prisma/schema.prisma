// UNDIMENSION — Prisma Schema (Complete — 16 tables)
// Uses Supabase PostgreSQL for both local dev and production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════════════════
// ABOUT PAGE TABLES (5)
// ═══════════════════════════════════════════════════════════════════════════

model Member {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  nick            String
  role            String
  img             String
  color           String
  highlight       String
  bio             String
  tagline         String   @default("")
  quote           String   @default("")
  funFactsJson    String   @default("[]")
  element         String   @default("")
  joinYear        String   @default("2020")
  statsJson       String   @default("[]")
  socialsJson     String   @default("[]")
  taglineCareer   String   @default("")
  location        String   @default("")
  availability    String   @default("EMPLOYED")
  educationJson   String   @default("[]")
  workHistoryJson String   @default("[]")
  skillsJson      String   @default("[]")
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dndCharacters       DnDCharacter[]
  portfolioProjects   PortfolioProject[]
  achievements        Achievement[]
  gamePlayerStats     GamePlayerStat[]
  gameCompatibilities GameCompatibility[]
  profileHistory      MemberProfileHistory[]

  @@index([order])
}

/// Profile history snapshots — saved before each member update.
/// Max 4 per member. When adding a 5th, the oldest is deleted.
model MemberProfileHistory {
  id              String   @id @default(cuid())
  member          Member   @relation(fields: [memberSlug], references: [slug], onDelete: Cascade)
  memberSlug      String
  name            String
  nick            String
  role            String
  img             String
  color           String
  highlight       String
  bio             String
  tagline         String   @default("")
  quote           String   @default("")
  funFactsJson    String   @default("[]")
  element         String   @default("")
  joinYear        String   @default("2020")
  statsJson       String   @default("[]")
  socialsJson     String   @default("[]")
  taglineCareer   String   @default("")
  location        String   @default("")
  availability    String   @default("EMPLOYED")
  educationJson   String   @default("[]")
  workHistoryJson String   @default("[]")
  skillsJson      String   @default("[]")
  createdAt       DateTime @default(now())

  @@index([memberSlug])
  @@index([createdAt])
}

model Quote {
  id        String   @id @default(cuid())
  text      String
  author    String   @default("THE COLLECTIVE")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

model GuestbookEntry {
  id        String   @id @default(cuid())
  name      String
  message   String
  color     String   @default("#ff4d4d")
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model NewsArticle {
  id        String   @id @default(cuid())
  title     String
  body      String
  category  String   @default("UPDATE")
  author    String   @default("THE COLLECTIVE")
  img       String?
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// GALLERY TABLE (1)
// ═══════════════════════════════════════════════════════════════════════════

model GalleryPhoto {
  id        String   @id @default(cuid())
  title     String
  img       String   // URL → Supabase: gallery/uploads/*.webp
  author    String
  date      String
  rotate    String   @default("-rotate-2")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([author])
}

// ═══════════════════════════════════════════════════════════════════════════
// GAMES TABLES (5)
// ═══════════════════════════════════════════════════════════════════════════

/// Game metadata (Minecraft, Roblox, ML, D&D)
model Game {
  id            String   @id @default(cuid())
  gameId        String   @unique // 'minecraft', 'roblox', 'ml', 'dnd'
  sector        String   // 'SEKTOR 01'
  title         String   // 'MINECRAFT'
  subtitle      String   // 'SURVIVAL OF THE FITTEST'
  description   String
  bgImg         String   // URL → Supabase: games/backgrounds/*.webp
  accent        String   // '#5d9e35'
  carouselTitle String   // 'OUR WORLD'
  reverse       Boolean  @default(false)
  fontClass     String?  // 'font-cinzel' for D&D
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  // Relations
  moments        GameMoment[]
  playerStats    GamePlayerStat[]
  players        GamePlayer[]
  compatibilities GameCompatibility[]

  @@index([order])
}

/// Game players — can be collective members OR external players.
/// Independent of Member so games can include non-collective players
/// (e.g. friends, rivals, guests). Each player has their OWN photo
/// (not the member profile photo) so a member can use a different
/// avatar per game, and external players have their own photo too.
model GamePlayer {
  id           String   @id @default(cuid())
  gameId       String   // FK → Game.gameId
  game         Game     @relation(fields: [gameId], references: [gameId])
  name         String   // full display name (e.g. "Raynaldi" or "Guest Player")
  nick         String   // short alias (e.g. "Aldi" or "RandomJoe")
  img          String?  // player photo (URL → Supabase games/players/*.webp). NULL = unavailable state.
  color        String   @default("#ff8c00") // brand color for this player's chip
  role         String?  // ML: 'MIDLANER', 'JUNGLER', etc.
  favHero     String?  // ML: 'Lancelot'
  rank         String?  // ML: 'Mythic Glory'
  kda          String?  // ML: '4.2/2.1/5.8'
  winRate      String?  // ML: '68%'
  dndCharacter String?  // DnD: character name (if this is a DnD player)
  dndRace      String?
  dndClass     String?
  dndLevel     Int      @default(1)
  isMember     Boolean  @default(false) // true if this player is a collective member
  memberSlug   String?  // optional FK to Member.slug (only if isMember=true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([gameId])
  @@index([isMember])
}

/// Game moment photos (Minecraft/Roblox/ML moments)
model GameMoment {
  id          String   @id @default(cuid())
  gameId       String   // FK → Game.gameId
  game         Game     @relation(fields: [gameId], references: [gameId])
  title       String
  description String?
  img         String   // URL → Supabase: games/moments/*.webp
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([gameId])
  @@index([createdAt])
}

/// Per-member per-game stats (ML pro player: role, hero, KDA, WR)
model GamePlayerStat {
  id         String   @id @default(cuid())
  memberId   String   // FK → Member.slug
  member     Member   @relation(fields: [memberId], references: [slug])
  gameId     String   // FK → Game.gameId
  game       Game     @relation(fields: [gameId], references: [gameId])
  role       String?  // ML: 'MIDLANER', 'JUNGLER', etc.
  favHero    String?  // ML: 'Lancelot'
  rank       String?  // ML: 'Mythic Glory'
  kda        String?  // ML: '4.2/2.1/5.8'
  winRate    String?  // ML: '68%'
  createdAt  DateTime @default(now())

  @@unique([memberId, gameId])
  @@index([memberId])
  @@index([gameId])
}

/// Play Matrix — member × game compatibility (0-3)
model GameCompatibility {
  id        String   @id @default(cuid())
  memberId  String   // FK → Member.slug
  member    Member   @relation(fields: [memberId], references: [slug])
  gameId    String   // FK → Game.gameId
  game      Game     @relation(fields: [gameId], references: [gameId])
  level     Int      @default(0) // 0=none, 1=rare, 2=casual, 3=main
  createdAt DateTime @default(now())

  @@unique([memberId, gameId])
  @@index([memberId])
  @@index([gameId])
}

/// D&D characters per member
model DnDCharacter {
  id            String   @id @default(cuid())
  memberId      String   // FK → Member.slug
  member        Member   @relation(fields: [memberId], references: [slug])
  characterName String
  race          String
  charClass     String   // 'class' is reserved
  level         Int      @default(1)
  img           String?  // URL → Supabase: games/dnd/characters/*.webp
  str           Int      @default(10)
  dex           Int      @default(10)
  con           Int      @default(10)
  int           Int      @default(10)
  wis           Int      @default(10)
  cha           Int      @default(10)
  createdAt     DateTime @default(now())

  @@index([memberId])
}

/// D&D campaigns
model DnDCampaign {
  id           String   @id @default(cuid())
  name         String
  dm           String   // Dungeon Master
  status       String   @default("ONGOING")
  description  String
  storyOutline String?  // Alur cerita kampanye
  sessions     Int      @default(0)
  createdAt    DateTime @default(now())

  // Relations
  images DnDCampaignImage[]

  @@index([createdAt])
}

/// D&D campaign location/scene photos
model DnDCampaignImage {
  id         String   @id @default(cuid())
  campaignId String   // FK → DnDCampaign.id
  campaign   DnDCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  img        String   // URL → Supabase: games/dnd/locations/*.webp
  caption    String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([campaignId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PORTFOLIO TABLES (4)
// ═══════════════════════════════════════════════════════════════════════════

/// Portfolio projects per member
model PortfolioProject {
  id          String   @id @default(cuid())
  memberId    String   // FK → Member.slug
  member      Member   @relation(fields: [memberId], references: [slug])
  title       String
  description String
  techJson    String   @default("[]") // ["Next.js", "TypeScript"]
  category    String   @default("WEB") // WEB, GAME, MOBILE, TOOL, BOT, OTHER
  status      String   @default("LIVE") // LIVE, WIP, ARCHIVED
  year        String
  link        String?  // Live demo URL
  repo        String?  // GitHub repo URL
  color       String   @default("#ff4d4d")
  createdAt   DateTime @default(now())

  // Relations
  images PortfolioProjectImage[]

  @@index([memberId])
  @@index([category])
}

/// Portfolio project screenshot images
model PortfolioProjectImage {
  id         String   @id @default(cuid())
  projectId  String   // FK → PortfolioProject.id
  project    PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  img        String   // URL → Supabase: portfolio/projects/*.webp
  caption    String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([projectId])
}

/// Achievements per member (sertifikat, medali, milestone)
model Achievement {
  id          String   @id @default(cuid())
  memberId    String   // FK → Member.slug
  member      Member   @relation(fields: [memberId], references: [slug])
  title       String
  year        String
  description String
  createdAt   DateTime @default(now())

  // Relations
  images AchievementImage[]

  @@index([memberId])
}

/// Achievement evidence photos (sertifikat, medali, foto kemenangan)
model AchievementImage {
  id            String   @id @default(cuid())
  achievementId String   // FK → Achievement.id
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  img           String   // URL → Supabase: portfolio/achievements/*.webp
  caption       String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([achievementId])
}
